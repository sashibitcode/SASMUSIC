# ========================================================
# Client-side Public Variables (Read-Only Streaming)
# ========================================================
# Google Drive Folder ID (public folder with "Anyone with the link can view")
VITE_DRIVE_FOLDER_ID=your_google_drive_folder_id_here

# Google Drive API Key (from Google Cloud Console with Drive API enabled)
VITE_DRIVE_API_KEY=your_google_drive_api_key_here

# ========================================================
# Server-side Variables (Vercel Serverless Upload /api)
# Never expose these to the client!
# ========================================================
# Google OAuth 2.0 Web Client ID
GOOGLE_CLIENT_ID=your_oauth_client_id.apps.googleusercontent.com

# Google OAuth 2.0 Client Secret
GOOGLE_CLIENT_SECRET=your_oauth_client_secret

# Google OAuth 2.0 Refresh Token (generated via `node scripts/get-refresh-token.js`)
GOOGLE_REFRESH_TOKEN=your_oauth_refresh_token

# Google Drive Folder ID where songs are uploaded
DRIVE_FOLDER_ID=your_google_drive_folder_id_here

# Password required to unlock the upload feature in the UI
UPLOAD_PASSWORD=your_secure_upload_password_here

# Random secret string for signing upload session JWTs (at least 32 characters)
JWT_SECRET=your_random_32_character_jwt_secret_key_here

# Allowed Origin for CORS (e.g. https://sas-music.vercel.app or * for all)
ALLOWED_ORIGIN=*
